{
  "name": "@nyuccl/smile",
  "version": "0.2.0-beta.0",
  "description": "SMILE experiment framework as a Nuxt module",
  "author": "Todd Gureckis <gureckis@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyuccl/smile.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm run lint && pnpm run test && bumpp --no-push && node scripts/sync-starter-version.js && git add start/package.json && git commit --amend --no-edit && pnpm run prepack && changelogen --no-bump && pnpm publish --access public --tag beta && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "generate-env": "bash scripts/generate_git_env.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "smile:hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "@codenamize/codenamize": "1.1.1",
    "@internationalized/date": "^3.7.0",
    "@libsql/client": "^0.14.0",
    "@nuxt/kit": "^4.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.1.10",
    "@vueuse/core": "^12.8.2",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.38.0",
    "json-stable-stringify": "^1.2.1",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.517.0",
    "motion": "^12.3.1",
    "pinia": "^3.0.4",
    "qrcode-svg": "^1.1.0",
    "reka-ui": "^2.6.1",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.4",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.4.1",
    "uuid": "^11.0.5",
    "vue-sonner": "^2.0.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.351",
    "@mdit/plugin-sub": "^0.16.0",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.13.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^3.23.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "latest",
    "@vue/test-utils": "^2.4.6",
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.8.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "nuxt": "^4.3.0",
    "prettier": "^3.4.2",
    "shiki": "^2.3.1",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
