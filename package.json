{
  "name": "@nyuccl/smile-nuxt",
  "version": "0.2.0-beta.7",
  "description": "SMILE experiment framework as a Nuxt module",
  "author": "Todd Gureckis <gureckis@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyuccl/smile.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm whoami && pnpm run lint && pnpm run test && bumpp --no-push --no-commit --no-tag && node scripts/sync-starter-version.js && changelogen --output && pnpm run prepack && node scripts/finalize-release.js && pnpm publish --access public --tag beta && git push --follow-tags && node scripts/github-release.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:overrides": "node scripts/test-overrides.mjs",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "generate-env": "bash scripts/generate_git_env.sh",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.js",
    "db:bundle": "node scripts/bundle-migrations.js",
    "db:migrate": "drizzle-kit migrate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "smile:hash-password": "node scripts/hash-password.js",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codenamize/codenamize": "1.1.1",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.14.0",
    "@nuxt/kit": "^4.6.3",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^12.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.4",
    "json-stable-stringify": "^1.3.0",
    "lodash": "^4.18.1",
    "lucide-vue-next": "^0.517.0",
    "motion": "^12.43.0",
    "pinia": "^3.0.4",
    "qrcode-svg": "^1.1.0",
    "reka-ui": "^2.11.0",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^28.8.0",
    "uuid": "^11.1.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.550",
    "@mdit/plugin-sub": "^0.16.0",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "nuxt": "^4.6.3",
    "prettier": "^3.9.10",
    "shiki": "^2.5.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
