# =============================================================================
# SMILE Experiment Configuration — Full Reference
# =============================================================================
# Copy this file to .env.local and fill in your secrets.
# .env.local is gitignored and will NOT be committed.
#
# Values in .env.local override values in .env (the tracked defaults).
# =============================================================================

# --- Secrets (put these in .env.local, NOT .env) ---

# Database: Turso (production) or local SQLite (dev)
#
# By default, SMILE uses a local SQLite file at .data/experiment.db — no
# configuration needed for development.
#
# To connect to a remote Turso database (for production / deployed experiments):
#   1. Create a database at https://turso.tech
#   2. Copy the URL and auth token into .env.local (this file is gitignored)
#   3. Restart the dev server — you'll see "Turso" in the startup log
#
# To switch back to local SQLite, comment out or remove these lines.
#
# TURSO_DATABASE_URL              = libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN                = your-turso-auth-token

# Dev/presentation mode password (override the default "1234")
# Supports plaintext or bcrypt hash. To generate a hash:
#   pnpm smile:hash-password
# SMILE_DEV_PASSWORD              = your-secure-password-or-bcrypt-hash
# Allow /presentation without a password (default: false)
# SMILE_PUBLIC_PRESENTATION       = true

# Google Analytics (optional)
# VITE_GOOGLE_ANALYTICS           = G-XXXXXXXXXX

# --- UI & Display ---
# VITE_COLOR_MODE                 = light          # light | dark | system
# VITE_RESPONSIVE_UI              = true
# VITE_WINDOWSIZER_REQUEST        = 800x600        # WIDTHxHEIGHT
# VITE_WINDOWSIZER_AGGRESSIVE     = true
# VITE_ANONYMOUS_MODE             = false           # hide lab branding

# --- Branding ---
# VITE_LAB_URL                    = https://mylab.edu
# VITE_BRAND_LOGO_FN              = universitylogo.png

# --- Experiment behavior ---
# VITE_ALLOW_REPEATS              = false
# VITE_RANDOM_SEED                = 100012

# --- Data saving ---
# VITE_AUTO_SAVE_DATA             = true
# VITE_MAX_WRITES                 = 1000
# VITE_MIN_WRITE_INTERVAL         = 1000

# --- Stepper ---
# VITE_MAX_STEPS                  = 5000

# --- Auto-generated (do NOT edit manually) ---
# These are set by scripts/generate_git_env.sh -> .env.git.local
# VITE_PROJECT_NAME               = (from git remote)
# VITE_GIT_HASH                   = (short commit hash)
# VITE_GIT_REPO_NAME              = (repo name)
# VITE_GIT_OWNER                  = (github org/user)
# VITE_GIT_BRANCH_NAME            = (current branch)
# VITE_DEPLOY_BASE_PATH           = /owner/repo/branch/
# VITE_CODE_NAME                  = (deterministic codename)
# VITE_GIT_LAST_MSG               = (last commit message)
# VITE_PROJECT_REF                = owner-repo-branch
# VITE_SMILE_VERSION              = (from package.json)
