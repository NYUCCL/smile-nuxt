# =============================================================================
# SMILE Experiment Configuration — Safe Defaults (tracked by git)
# =============================================================================
# These are non-secret defaults for your experiment.
# Override locally in .env.local (gitignored) or in design.js via
# api.setRuntimeConfig().
#
# For secrets (database tokens, passwords), see .env.local.example.
# =============================================================================

# --- UI & Display ---
VITE_COLOR_MODE                  = light
VITE_RESPONSIVE_UI               = true
VITE_WINDOWSIZER_REQUEST         = 800x600
VITE_WINDOWSIZER_AGGRESSIVE      = true
VITE_ANONYMOUS_MODE              = false

# --- Branding ---
VITE_LAB_URL                     = https://mylab.edu
VITE_BRAND_LOGO_FN               = universitylogo.png

# --- Experiment behavior ---
VITE_ALLOW_REPEATS               = false
VITE_RANDOM_SEED                 = 100012

# --- Data saving ---
VITE_AUTO_SAVE_DATA              = true
VITE_MAX_WRITES                  = 1000
VITE_MIN_WRITE_INTERVAL          = 2000

# --- Stepper ---
VITE_MAX_STEPS                   = 5000

# --- Dev & presentation route access (deployed sites only) ---
# By default /dev/ and /presentation/ are DISABLED on deployed sites — they 404
# as if they don't exist. Local `pnpm dev` always has them open, no password.
#
# Opt in per route by setting its access mode (and a password). Put these in
# your host's dashboard (e.g. Vercel > Environment Variables) for production, or
# in .env.local to test the gate locally. They are read at runtime, so changing
# them in the dashboard takes effect without a rebuild.
#
#   SMILE_DEV_ACCESS            = password   # disabled (default) | password | open
#   SMILE_DEV_PASSWORD          = <secret>   # required when dev access = password
#   SMILE_PRESENTATION_ACCESS   = password   # disabled (default) | password | open
#   SMILE_PRESENTATION_PASSWORD = <secret>   # required when presentation access = password
#
# Shortcuts: setting a route's password alone opts it into `password` mode.
# `open` = public, no password — only for the rare case you truly want that.
# Hash a password instead of storing plaintext with: pnpm smile:hash-password
